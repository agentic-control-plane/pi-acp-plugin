{
  "name": "@agenticcontrolplane/pi",
  "version": "0.1.1",
  "description": "Agentic Control Plane for pi (earendil-works) — check every tool call against your policies before it runs, and keep a durable record of what was allowed and why.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "earendil",
    "agentic-control-plane",
    "agent-security",
    "tool-call-policy",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-control-plane/pi-acp-plugin.git"
  },
  "homepage": "https://agenticcontrolplane.com/controls/pi",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
